---
import { getCollection } from 'astro:content';
import QuelleItem from '../components/QuelleItem.astro';
import Base from '../layouts/Base.astro';
const quellen = (await getCollection('quellen')).map((q) => q.data).sort((a, b) => a.title.localeCompare(b.title, 'de'));
---
<Base title="Quellenverzeichnis" current="">
  <article class="page">
    <h1>Quellenverzeichnis</h1>
    <ul>
      {quellen.map((q) => (
        <QuelleItem q={q} />
      ))}
    </ul>
  </article>
</Base>
