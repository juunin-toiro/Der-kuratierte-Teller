---
import { url } from '../lib/url';
import type { loadPosts } from '../lib/posts';
interface Props { posts: Awaited<ReturnType<typeof loadPosts>> }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <h3><a href={url(`/wissenswertes/${p.slug}/`)}>{p.title}</a></h3>
      {p.kategorie && <p class="post-kat">{p.kategorie}</p>}
      <p>{p.teaser}</p>
    </li>
  ))}
</ul>
